{
  "name": "@app/web",
  "version": "0.1.0",
  "private": true,
  "description": "Jedyny Worker Cloudflare: strony TanStack Start (SSR, Workers Cache) + API Hono z apps/server pod /api i cron.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3000 --strictPort",
    "deploy": "bun ../../tools/scripts/deploy.ts",
    "deploy:preview": "bun ../../tools/scripts/deploy.ts --env preview",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env production",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:js-budget": "bun scripts/check-js-budget.ts"
  },
  "dependencies": {
    "@app/cache": "workspace:*",
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/env": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/rpc": "workspace:*",
    "@app/server": "workspace:*",
    "@app/start-kit": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "6.19.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "use-intl": "4.14.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "wrangler": "^4.151.0"
  }
}
