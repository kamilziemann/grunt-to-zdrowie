{
  "name": "@app/bdot-import",
  "version": "0.1.0",
  "private": true,
  "description": "Jednorazowy import hydrografii BDOT10k (rowy, cieki, kanaly, wody, mokradla) z krajowych plikow GeoParquet GUGiK do Postgresa z PostGIS (Neon).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "hyparquet": "^1.33.1",
    "hyparquet-compressors": "^1.1.3"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@types/bun": "^1.4.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
