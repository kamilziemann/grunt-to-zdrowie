{
  "name": "@app/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schemat Drizzle dla Cloudflare D1, fabryka klienta, generator id i migracje SQL (stosowane przez wrangler).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && bun run scripts/check-migrations.ts"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
