{
  "name": "@app/start-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Wspolne narzedzia aplikacji TanStack Start na Cloudflare Workers: klient API (Hono w procesie / fetch), naglowki cache tras, SEO, slad odslony i raporty bledow przegladarki, skrypt motywu, QueryClient, zwykle query stringi.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/worker/index.ts",
      "default": "./src/worker/index.ts"
    }
  },
  "scripts": {
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/cache": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/rpc": "workspace:*"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "jsdom": "^31.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.169.0"
  }
}
