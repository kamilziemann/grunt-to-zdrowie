{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    ".claude/**",
    ".agents/skills/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/migrations/**",
    "bun.lock",
    "tools/architecture-check/test/fixtures/**",
    "**/fixtures/**/*.html"
  ]
}
